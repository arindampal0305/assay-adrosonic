# Copy to .env (gitignored) and fill in. Read by backend/__init__.py on import;
# a variable already exported in the real environment wins over this file.
#
# Adjudication is optional. With no provider configured the pipeline still maps
# every column from deterministic evidence; it reports the columns it would have
# asked about as an `adjudicator_unavailable` issue plus an audit record.

# Which provider adjudicates low-margin columns: openai | ollama
# Ignored when OPENAI_API_KEY is non-empty — OpenAI always takes precedence.
ASSAY_LLM_PROVIDER=openai

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
ASSAY_LLM_MODEL=gpt-4o-mini

# --- Ollama (local, no key) -------------------------------------------------
# Used only when OPENAI_API_KEY is empty and ASSAY_LLM_PROVIDER=ollama.
# get_client() probes /api/tags at startup and falls back to no-adjudication if
# the daemon is down or the model is not pulled.
OLLAMA_BASE_URL=http://localhost:11434
ASSAY_OLLAMA_MODEL=llama3.1

# Seconds allowed for one completion, and for the Ollama startup probe.
ASSAY_LLM_TIMEOUT=20
ASSAY_OLLAMA_PROBE_TIMEOUT=2

# --- API --------------------------------------------------------------------
ASSAY_UPLOAD_DIR=data/uploads
